"""
Run once to create the database and load starter data:

    python seed.py

This creates three demo pharmacies (with login credentials printed at the
end) and a small shared medication catalog so the search page has
something to find immediately. Safe to re-run — it skips anything that
already exists.
"""

import sqlite3
from datetime import datetime
from werkzeug.security import generate_password_hash

from app import DB_PATH, init_db

PHARMACIES = [
    {"name": "Life Care Pharmacy", "username": "lifecare", "password": "lifecare123",
     "address": "12 Main Street", "phone": "555-0101"},
    {"name": "Friends Pharmacy", "username": "friends", "password": "friends123",
     "address": "48 Market Road", "phone": "555-0102"},
    {"name": "Well Being Pharmacy", "username": "wellbeing", "password": "wellbeing123",
     "address": "7 Church Avenue", "phone": "555-0103"},
]

MEDICATIONS = [
    ("Panadol", "Paracetamol"),
    ("Tylenol", "Acetaminophen"),
    ("Advil", "Ibuprofen"),
    ("Amoxil", "Amoxicillin"),
    ("Claritin", "Loratadine"),
    ("Zyrtec", "Cetirizine"),
    ("Ventolin Inhaler", "Salbutamol"),
    ("Glucophage", "Metformin"),
    ("Lipitor", "Atorvastatin"),
    ("Amoxiclav", "Amoxicillin/Clavulanate"),
]

# (pharmacy index, medication index, price, in_stock)
SAMPLE_INVENTORY = [
    (0, 0, 3.50, 1), (1, 0, 3.00, 1), (2, 0, 3.75, 1),
    (0, 1, 5.00, 1), (1, 1, 5.50, 0), (2, 1, 4.90, 1),
    (0, 2, 4.20, 1), (1, 2, 3.95, 1), (2, 2, 4.50, 0),
    (0, 3, 8.00, 1), (1, 3, 7.50, 1),
    (1, 4, 6.20, 1), (2, 4, 6.00, 1),
    (0, 5, 7.10, 1), (2, 5, 6.85, 1),
    (0, 6, 12.00, 1), (1, 6, 11.50, 1), (2, 6, 12.25, 1),
    (1, 7, 9.00, 1), (2, 7, 8.75, 0),
    (0, 8, 15.00, 1), (1, 8, 14.50, 1),
]


def seed():
    init_db()
    db = sqlite3.connect(DB_PATH)

    pharmacy_ids = []
    for p in PHARMACIES:
        existing = db.execute("SELECT id FROM pharmacies WHERE username = ?", (p["username"],)).fetchone()
        if existing:
            pharmacy_ids.append(existing[0])
            continue
        cur = db.execute(
            "INSERT INTO pharmacies (name, username, password_hash, address, phone) VALUES (?, ?, ?, ?, ?)",
            (p["name"], p["username"], generate_password_hash(p["password"]), p["address"], p["phone"]),
        )
        pharmacy_ids.append(cur.lastrowid)

    medication_ids = []
    for name, generic in MEDICATIONS:
        existing = db.execute("SELECT id FROM medications WHERE name = ?", (name,)).fetchone()
        if existing:
            medication_ids.append(existing[0])
            continue
        cur = db.execute("INSERT INTO medications (name, generic_name) VALUES (?, ?)", (name, generic))
        medication_ids.append(cur.lastrowid)

    now = datetime.utcnow().isoformat()
    for p_idx, m_idx, price, in_stock in SAMPLE_INVENTORY:
        db.execute(
            """
            INSERT INTO inventory (pharmacy_id, medication_id, price, in_stock, updated_at)
            VALUES (?, ?, ?, ?, ?)
            ON CONFLICT(pharmacy_id, medication_id) DO NOTHING
            """,
            (pharmacy_ids[p_idx], medication_ids[m_idx], price, in_stock, now),
        )

    db.commit()
    db.close()

    print("Database ready.\n")
    print("Demo pharmacy logins:")
    for p in PHARMACIES:
        print(f"  {p['name']}: username='{p['username']}'  password='{p['password']}'")


if __name__ == "__main__":
    seed()
