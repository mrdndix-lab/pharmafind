# Copy this file to .env (and don't commit the real one) or set these as
# real environment variables on your host/PaaS.

# Required in production — a long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Your deployed frontend's exact origin(s), comma-separated. Must match
# exactly (scheme + host + port) or the browser will block the API calls.
ALLOWED_ORIGINS=https://www.pharmafind.example

# Set to 1 once you're behind a reverse proxy that forwards
# X-Forwarded-Proto (Render, Railway, Fly.io, Heroku, nginx, Caddy all do).
FORCE_HTTPS=1

# Optional. Only used by ai_suggest_categories() in app.py, as a fallback
# for free-text searches the built-in symptom dictionary doesn't cover.
# ANTHROPIC_API_KEY=sk-ant-...

PORT=5000
